#!/usr/bin/env bash
# Aplica wallpapers de Wallpaper Engine, uno por pantalla, cada uno en su PROPIO proceso
# de linux-wallpaperengine. Asi, si el motor crashea al renderizar un wallpaper concreto
# (ocurre con algunas escenas rotas/incompatibles), solo se cae esa pantalla y no las demas.
# Uso: wallpaperengine-apply PANTALLA=ID [PANTALLA=ID ...]
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
source "$SCRIPT_DIR/wallpaperengine-common.sh"

STEAM_LIB=$(wpe_get_steam_library)
WORKSHOP_DIR="$STEAM_LIB/steamapps/workshop/content/$WPE_APPID"
ASSETS_DIR="$STEAM_LIB/steamapps/common/wallpaper_engine/assets"
CONF_DIR="$WPE_CONF_DIR"
CURRENT_FILE="$CONF_DIR/current.json"

if [[ $# -eq 0 ]]; then
    echo "Uso: wallpaperengine-apply PANTALLA=ID [PANTALLA=ID ...]" >&2
    exit 1
fi

mkdir -p "$CONF_DIR"

declare -A ASSIGN
# Partimos de lo que ya estaba guardado, para no perder la configuracion de pantallas
# que no se mencionan en esta llamada.
if [[ -f "$CURRENT_FILE" ]]; then
    while IFS=$'\t' read -r screen id; do
        [[ -n "$screen" ]] && ASSIGN["$screen"]="$id"
    done < <(jq -r 'to_entries[] | "\(.key)\t\(.value)"' "$CURRENT_FILE" 2>/dev/null)
fi

for pair in "$@"; do
    screen="${pair%%=*}"
    id="${pair#*=}"
    if [[ -z "$screen" || -z "$id" || "$screen" == "$pair" ]]; then
        echo "Formato invalido: '$pair' (usa PANTALLA=ID)" >&2
        exit 1
    fi
    if [[ ! "$id" =~ ^[0-9]+$ ]]; then
        echo "ID invalido: '$id' (solo digitos)" >&2
        exit 1
    fi
    if [[ ! "$screen" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Nombre de pantalla invalido: '$screen'" >&2
        exit 1
    fi
    if [[ ! -d "$WORKSHOP_DIR/$id" ]]; then
        echo "No existe el wallpaper con id $id en $WORKSHOP_DIR" >&2
        exit 1
    fi
    ASSIGN["$screen"]="$id"
done

KNOWN_BAD_FILE="$CONF_DIR/known_bad.json"
SCALING_FILE="$CONF_DIR/scaling.json"
PROPERTIES_FILE="$CONF_DIR/properties.json"
AUDIO_FILE="$CONF_DIR/audio.json"
SPEED_FILE="$CONF_DIR/speed.json"

# Argumentos de velocidad de reproduccion para ESTA pantalla ("--speed N", solo si
# distinto de 1.0 para no pasar el flag innecesariamente). Requiere una version de
# linux-wallpaperengine con el flag --speed (parcheado en esta sesion); si el motor
# instalado no lo soporta, --set-property/etc siguen funcionando igual, solo este
# flag concreto daria error de argumento desconocido.
wpe_get_speed_args() {
    local screen="$1"
    [[ -s "$SPEED_FILE" ]] || return 0
    local speed
    speed=$(jq -r --arg s "$screen" '.[$s] // 1.0' "$SPEED_FILE" 2>/dev/null)
    if [[ -n "$speed" && "$speed" != "1" && "$speed" != "1.0" ]]; then
        echo "--speed"
        echo "$speed"
    fi
}

# Argumentos de audio para ESTA pantalla: silenciado por defecto (igual que antes),
# o "--volume N" si el usuario ha activado el audio para esa pantalla desde el panel
# "Audio" de la app. --silent y --volume son mutuamente excluyentes para el motor.
wpe_get_audio_args() {
    local screen="$1"
    if [[ -s "$AUDIO_FILE" ]]; then
        local muted volume
        # OJO: "// true" colapsaria un "muted": false explicito de vuelta a true,
        # porque en jq el operador // trata `false` igual que `null`. Por eso aqui
        # se comprueba null explicitamente en vez de usar //.
        muted=$(jq -r --arg s "$screen" '.[$s].muted | if . == null then true else . end' "$AUDIO_FILE" 2>/dev/null)
        volume=$(jq -r --arg s "$screen" '.[$s].volume // 50' "$AUDIO_FILE" 2>/dev/null)
        if [[ "$muted" == "false" ]]; then
            echo "--volume"
            echo "$volume"
            return
        fi
    fi
    echo "--silent"
}

# Argumentos --set-property clave=valor guardados para ESTE wallpaper (panel
# "Personalizar" de la app), como array bash listo para pasar al motor.
wpe_get_property_args() {
    local id="$1"
    [[ -s "$PROPERTIES_FILE" ]] || return 0
    jq -r --arg id "$id" '.[$id] // {} | to_entries[] | "--set-property\n\(.key)=\(.value)"' "$PROPERTIES_FILE" 2>/dev/null
}

# Modo de escalado guardado para una pantalla ("fill" recorta para rellenar,
# "fit" ajusta sin recortar dejando bordes si hace falta, "stretch" estira,
# "default" deja que decida la propia escena). "fill" si no hay nada guardado.
wpe_get_scaling() {
    local screen="$1"
    if [[ -s "$SCALING_FILE" ]]; then
        jq -r --arg s "$screen" '.[$s] // "fill"' "$SCALING_FILE" 2>/dev/null || echo "fill"
    else
        echo "fill"
    fi
}

# Espera (de verdad, con wait, no con un sleep fijo) a que el proceso termine, y
# comprueba COMO murio para decidir si fue un crash o un cambio deliberado de
# wallpaper; si es un crash, lo apunta en known_bad.json para que la app lo marque.
#
# IMPORTANTE: `wait "$pid"` solo devuelve el codigo de salida real si $pid es hijo
# DIRECTO del proceso bash que ejecuta esta funcion — por eso restart_screen llama a
# esta funcion de forma SINCRONA (sin "&" ni subshell de por medio) justo despues de
# lanzar nohup, en el mismo subshell. Un codigo de salida >=128 significa que el
# proceso murio por una señal (128+N; 139=SIGSEGV, 134=SIGABRT, 143=SIGTERM...) — esto
# detecta tambien segfaults silenciosos que nunca imprimen nada reconocible en el log
# (visto en produccion: un wallpaper moria con exit code 139 sin ningun mensaje de
# error, así que el chequeo de texto anterior nunca lo habria detectado).
#
# Cuidado para no dar falsos positivos: cuando cambiamos de wallpaper deliberadamente,
# restart_screen mata al proceso viejo con SIGTERM (codigo de salida 143) — eso
# tambien es ">=128" pero NO es un crash. Se distingue comprobando si el pidfile
# TODAVIA apunta a este pid cuando termina: si ya no coincide, alguien lo reemplazo
# a proposito (nosotros mismos, matandolo mas arriba) y no se toca known_bad.json.
watch_for_crash() {
    local screen="$1" id="$2" pid="$3" logfile="$4" log_start_lines="$5"

    local exit_code=0
    wait "$pid" 2>/dev/null || exit_code=$?

    local pidfile="$CONF_DIR/pid_${screen}.pid"
    local current_pid
    current_pid=$(cat "$pidfile" 2>/dev/null || true)
    if [[ "$current_pid" != "$pid" ]]; then
        return
    fi

    local current="{}"
    [[ -s "$KNOWN_BAD_FILE" ]] && current=$(cat "$KNOWN_BAD_FILE")

    local crashed=false
    if [[ "$exit_code" -ge 128 ]]; then
        crashed=true
    elif tail -n "+$((log_start_lines + 1))" "$logfile" 2>/dev/null | \
        grep -qE "terminate called|Segmentation fault|Aborted \(core dumped\)"; then
        crashed=true
    fi

    if $crashed; then
        echo "$current" | jq --arg id "$id" --arg screen "$screen" --arg ts "$(date -Iseconds)" \
            '.[$id] = {screen: $screen, detected_at: $ts}' > "$KNOWN_BAD_FILE.tmp.$$" 2>/dev/null \
            && mv -f "$KNOWN_BAD_FILE.tmp.$$" "$KNOWN_BAD_FILE" || rm -f "$KNOWN_BAD_FILE.tmp.$$"
    else
        echo "$current" | jq --arg id "$id" 'del(.[$id])' > "$KNOWN_BAD_FILE.tmp.$$" 2>/dev/null \
            && mv -f "$KNOWN_BAD_FILE.tmp.$$" "$KNOWN_BAD_FILE" || rm -f "$KNOWN_BAD_FILE.tmp.$$"
    fi
}

restart_screen() {
    local screen="$1" id="$2"
    local pidfile="$CONF_DIR/pid_${screen}.pid"
    local logfile="$CONF_DIR/wallpaperengine_${screen}.log"
    local lockfile="$CONF_DIR/lock_${screen}.lock"

    # Todo el bloque corre en un subshell en background (el "&" final), para no
    # bloquear al resto del script — el wallpaper vive indefinidamente y watch_for_crash
    # espera (con wait real, ver mas abajo) hasta que de verdad termine.
    (
        flock -x 200

        # Solo lo que decide "cual es el proceso vivo de esta pantalla" (matar el viejo,
        # lanzar el nuevo, escribir el pidfile) va bajo el lock exclusivo por pantalla.
        # Sin esto, dos llamadas a wallpaperengine-apply casi simultaneas para la misma
        # pantalla (p.ej. mover rapido el deslizador de volumen, o reaplicar justo
        # cuando la rotacion automatica tambien esta actuando) pueden leer el mismo
        # pidfile "viejo" antes de que la otra lo actualice, matar el mismo PID y acabar
        # lanzando VARIOS procesos de linux-wallpaperengine vivos a la vez en la misma
        # pantalla — visto en produccion: 5 procesos simultaneos agotando la VRAM
        # (CUDA_ERROR_OUT_OF_MEMORY).
        if [[ -f "$pidfile" ]]; then
            old_pid=$(cat "$pidfile" 2>/dev/null || true)
            if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
                kill "$old_pid" 2>/dev/null || true
                sleep 0.3
                kill -0 "$old_pid" 2>/dev/null && kill -9 "$old_pid" 2>/dev/null || true
            fi
        fi

        # Rotar el log si supera 5 MB (se conserva uno anterior como .1): evita logs
        # de cientos de MB y que el conteo de lineas de abajo sea lento.
        if [[ -f "$logfile" ]] && (( $(stat -c %s "$logfile") > 5242880 )); then
            mv -f "$logfile" "$logfile.1"
        fi

        log_start_lines=0
        [[ -f "$logfile" ]] && log_start_lines=$(wc -l < "$logfile")

        scaling=$(wpe_get_scaling "$screen")

        prop_args=()
        mapfile -t prop_args < <(wpe_get_property_args "$id")

        audio_args=()
        mapfile -t audio_args < <(wpe_get_audio_args "$screen")

        speed_args=()
        mapfile -t speed_args < <(wpe_get_speed_args "$screen")

        # 200>&- es imprescindible: sin cerrar explicitamente el descriptor del lock,
        # linux-wallpaperengine (que vive indefinidamente) lo hereda al hacer fork+exec y
        # se queda reteniendolo para siempre — flock() no libera el lock hasta que TODAS
        # las copias del descriptor se cierran. Sin esto, la siguiente vez que se intenta
        # cambiar el wallpaper de esa pantalla, el flock -x 200 de mas arriba se queda
        # esperando para siempre (visto en produccion: decenas de procesos
        # wallpaperengine-apply colgados sin poder aplicar nada, con `lsof` confirmando
        # que el propio proceso linux-wallpaperengine tenia el lockfile abierto en el
        # fd 200).
        nohup linux-wallpaperengine --assets-dir "$ASSETS_DIR" --fps 30 \
            --screen-root "$screen" --bg "$WORKSHOP_DIR/$id" --scaling "$scaling" --clamp border \
            "${audio_args[@]}" "${prop_args[@]}" "${speed_args[@]}" \
            >>"$logfile" 2>&1 200>&- &
        new_pid=$!
        echo "$new_pid" > "$pidfile"
        # OJO: aqui NO se hace disown de new_pid (a diferencia de versiones anteriores
        # de este script) — disown le dice a bash "deja de rastrear este job", y eso le
        # impide a `wait "$new_pid"` recuperar el codigo de salida real mas abajo (se
        # probo: con disown, wait devolvia 0 siempre, incluso cuando el proceso moria
        # por SIGSEGV con exit code 139 real). No hace falta disown para que el proceso
        # sobreviva sin problema al padre — nohup ya se encarga de eso.

        # Liberar el lock AHORA MISMO (cerrando nuestra propia copia del fd), en vez de
        # esperar a que todo el subshell termine — igual que antes, pero de forma
        # explicita, porque a partir de aqui watch_for_crash puede tardar indefinidamente
        # (hasta que el wallpaper de verdad termine) y no debe retener el lock mientras
        # tanto, o cualquier cambio posterior de wallpaper en esta pantalla se quedaria
        # esperando para siempre.
        exec 200>&-

        # Se llama de forma SINCRONA (sin "&"), en este mismo proceso bash, porque
        # `wait "$new_pid"` dentro de watch_for_crash solo puede esperar a un hijo
        # DIRECTO — si se lanzara en un subshell/job aparte, new_pid seria "hijo de mi
        # padre" desde su perspectiva, no suyo, y wait fallaria silenciosamente.
        watch_for_crash "$screen" "$id" "$new_pid" "$logfile" "$log_start_lines"
    ) 200>"$lockfile" &
    disown
}

for pair in "$@"; do
    screen="${pair%%=*}"
    id="${pair#*=}"
    restart_screen "$screen" "$id"
    echo "  $screen -> $id"
done

tmp=$(jq -n '{}')
for screen in "${!ASSIGN[@]}"; do
    tmp=$(echo "$tmp" | jq --arg k "$screen" --arg v "${ASSIGN[$screen]}" '. + {($k): $v}')
done
echo "$tmp" > "$CURRENT_FILE.tmp.$$" && mv -f "$CURRENT_FILE.tmp.$$" "$CURRENT_FILE"
