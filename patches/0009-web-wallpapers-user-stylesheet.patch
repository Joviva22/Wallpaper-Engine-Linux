 namespace {
+/**
+ * Optional user stylesheet for a web wallpaper: ~/.config/wallpaperengine-picker/web_css/<workshopId>.css
+ * (or all.css for every web wallpaper). Injected into the page as a <style> element once it has loaded,
+ * so the user can restyle it (e.g. replace the background) without touching the wallpaper's own files.
+ */
+std::string readUserCss (const std::string& workshopId) {
+    std::string base;
+
+    if (const char* xdg = getenv ("XDG_CONFIG_HOME"); xdg && *xdg) {
+	base = xdg;
+    } else if (const char* home = getenv ("HOME"); home && *home) {
+	base = std::string (home) + "/.config";
+    } else {
+	return "";
+    }
+
+    std::string css;
+
+    for (const std::string& name : { std::string ("all"), workshopId }) {
+	std::ifstream file (base + "/wallpaperengine-picker/web_css/" + name + ".css");
+
+	if (!file) {
+	    continue;
+	}
+
+	std::ostringstream content;
+
+	content << file.rdbuf ();
+	css += content.str () + "\n";
+    }
+
+    return css;
+}
+
+std::string buildUserCssScript (const std::string& css) {
+    if (css.empty ()) {
+	return "";
+    }
+
+    return "(function () {\n"
+	   "  var style = document.createElement ('style');\n"
+	   "  style.id = '__wpe_user_css';\n"
+	   "  style.textContent = "
+	+ nlohmann::json (css).dump ()
+	+ ";\n"
+	  "  (document.head || document.documentElement).appendChild (style);\n"
+	  "})();\n";
+}
