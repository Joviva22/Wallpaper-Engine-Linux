+glm::dvec2 WaylandMouseInput::consumeScroll () const {
+    // the active viewport is const-qualified for the other getters; the scroll counter is the one thing
+    // that is read-and-cleared here
+    auto* viewport = const_cast<WallpaperEngine::Render::Drivers::Output::WaylandOutputViewport*> (
+	this->getActiveOutputViewport ()
+    );
+
+    if (!viewport) {
+	return { 0.0, 0.0 };
+    }
+
+    const glm::dvec2 scroll = viewport->scroll;
+
+    viewport->scroll = { 0.0, 0.0 };
+
+    return scroll;
+}
