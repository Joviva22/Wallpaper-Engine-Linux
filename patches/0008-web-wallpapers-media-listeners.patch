+void CWeb::sendMediaState () {
+    if (!this->m_browser) {
+	return;
+    }
+
+    const auto frame = this->m_browser->GetMainFrame ();
+
+    if (!frame || !frame->IsValid ()) {
+	return;
+    }
+
+    const auto& media = this->getContext ().getMediaSource ().getMediaInfo ();
+    const auto now = std::chrono::steady_clock::now ();
+    const bool metadataChanged = !this->m_mediaSent || media.title != this->m_lastMedia.title
+	|| media.artist != this->m_lastMedia.artist || media.album != this->m_lastMedia.album
+	|| media.url != this->m_lastMedia.url || media.available != this->m_lastMedia.available;
+    const bool playbackChanged = !this->m_mediaSent || media.playbackState != this->m_lastMedia.playbackState;
+    const bool timelineDue = metadataChanged || playbackChanged
+	|| (media.playbackState == Media::MediaSource::Playing
+	    && now - this->m_lastTimelineSent >= std::chrono::milliseconds (500));
+
+    if (!metadataChanged && !playbackChanged && !timelineDue) {
+	return;
+    }
+
+    std::ostringstream script;
+    const auto send = [&script] (const char* kind, const nlohmann::json& event) {
+	script << "window.__wpeMedia&&window.__wpeMedia('" << kind << "'," << event.dump () << ");";
+    };
+
+    if (metadataChanged) {
+	// the media integration is always on; the page decides what to do with an empty track
+	send ("status", { { "enabled", true } });
+	send ("properties",
+	      { { "title", media.title },
+		{ "artist", media.artist },
+		{ "subTitle", "" },
+		{ "albumTitle", media.album },
+		{ "albumArtist", media.artist },
+		{ "genres", "" },
+		{ "contentType", "" } });
+	// colors are not extracted from the album art yet, so neutral defaults are sent (as the scene
+	// script bridge does)
+	send ("thumbnail",
+	      { { "thumbnail", media.url.value_or ("") },
+		{ "primaryColor", "#1f1f1f" },
+		{ "secondaryColor", "#000000" },
+		{ "tertiaryColor", "#404040" },
+		{ "textColor", "#ffffff" },
+		{ "highContrastColor", "#ffffff" } });
+    }
+
+    if (playbackChanged) {
+	send ("playback", { { "state", static_cast<int> (media.playbackState) } });
+    }
+
+    if (timelineDue) {
+	// MPRIS reports position and length in microseconds, web wallpapers expect seconds
+	send ("timeline", { { "position", media.position / 1000000.0 }, { "duration", media.duration / 1000000.0 } });
+	this->m_lastTimelineSent = now;
+    }
+
+    this->m_lastMedia = media;
+    this->m_mediaSent = true;
+    frame->ExecuteJavaScript (script.str (), frame->GetURL (), 0);
+}
