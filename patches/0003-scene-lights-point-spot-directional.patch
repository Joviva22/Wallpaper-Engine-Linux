+/**
+ * Scene light (scene.json objects with a "light" key). Kinds seen in the wild: "point",
+ * "lpoint", "lspot", "ltube" and "ldirectional".
+ */
+struct LightData {
+    std::string kind;
+    /** Linear RGB color */
+    UserSettingUniquePtr color;
+    UserSettingUniquePtr intensity;
+    /** Distance at which the light fades to nothing, in scene units */
+    UserSettingUniquePtr radius;
+    /** Euler angles in radians (direction for spot and directional lights) */
+    UserSettingUniquePtr angles;
+    UserSettingUniquePtr visible;
+    /** Falloff exponent (defaults to 1) */
+    float exponent;
+    /** Spot cone angles in degrees */
+    float innerCone;
+    float outerCone;
+};
+
+class Light : public Object, public LightData {
+public:
+    explicit Light (ObjectData data, LightData lightData) noexcept :
+	Object (std::move (data)), LightData (std::move (lightData)) { };
+    ~Light () override = default;
+};
 } // namespace WallpaperEngine::Data::Model
