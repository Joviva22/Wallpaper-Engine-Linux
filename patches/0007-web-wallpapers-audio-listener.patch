+void CWeb::sendAudioSpectrum () {
+    if (!this->m_browser) {
+	return;
+    }
+
+    const auto frame = this->m_browser->GetMainFrame ();
+
+    if (!frame || !frame->IsValid ()) {
+	return;
+    }
+
+    const auto& recorder = this->getAudioContext ().getRecorder ();
+    std::ostringstream script;
+
+    // 128 values: 64 for the left channel followed by the same 64 for the right one (the recorder is mono)
+    script << "window.__wpeAudio&&window.__wpeAudio([";
+
+    for (int channel = 0; channel < 2; channel++) {
+	for (int i = 0; i < 64; i++) {
+	    const float value = std::isfinite (recorder.audio64[i]) ? recorder.audio64[i] : 0.0f;
+
+	    script << (channel + i > 0 ? "," : "") << value;
+	}
+    }
+
+    script << "]);";
+    frame->ExecuteJavaScript (script.str (), frame->GetURL (), 0);
+}
