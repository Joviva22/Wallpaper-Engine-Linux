+
+void SubprocessApp::OnContextCreated (
+    CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame, CefRefPtr<CefV8Context> context
+) {
+    // wallpapers register listeners with these functions while loading, so they have to exist before any
+    // script runs. The audio listener receives a Float32Array of 128 values (64 left + 64 right), fed every
+    // frame by the main process through window.__wpeAudio.
+    static const char* script
+	= "(function () {\n"
+	  "  if (window.__wpeApiInstalled) return;\n"
+	  "  window.__wpeApiInstalled = true;\n"
+	  "  var audioListeners = [];\n"
+	  "  window.wallpaperRegisterAudioListener = function (callback) {\n"
+	  "    if (typeof callback === 'function') audioListeners.push (callback);\n"
+	  "  };\n"
+	  "  window.__wpeAudio = function (values) {\n"
+	  "    var data = new Float32Array (values);\n"
+	  "    for (var i = 0; i < audioListeners.length; i++) {\n"
+	  "      try { audioListeners[i] (data); } catch (e) { console.error (e); }\n"
+	  "    }\n"
+	  "  };\n"
+	  "  var ignored = ['wallpaperRegisterMediaStatusListener', 'wallpaperRegisterMediaPropertiesListener',\n"
+	  "    'wallpaperRegisterMediaThumbnailListener', 'wallpaperRegisterMediaPlaybackListener',\n"
+	  "    'wallpaperRegisterMediaTimelineListener'];\n"
+	  "  ignored.forEach (function (name) { if (!window[name]) window[name] = function () {}; });\n"
+	  "})();\n";
+
+    frame->ExecuteJavaScript (script, frame->GetURL (), 0);
+}
