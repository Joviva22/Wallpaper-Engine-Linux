 using namespace WallpaperEngine::WebBrowser;
 using namespace WallpaperEngine::WebBrowser::CEF;
 
+namespace {
+/**
+ * Wallpaper Engine hands web wallpapers their user properties by calling
+ * window.wallpaperPropertyListener.applyUserProperties ({ name: { value } }) once the page is
+ * ready. Without it, wallpapers that build their look from properties (background colour,
+ * position, size...) stay unstyled. The listener may be registered after the page's load event,
+ * so the call is retried for a few seconds.
+ */
+std::string buildUserPropertiesScript (const WallpaperEngine::Data::Model::Properties& properties) {
+    using namespace WallpaperEngine::Data::Model;
+
+    nlohmann::json values = nlohmann::json::object ();
+
+    for (const auto& [name, property] : properties) {
+	nlohmann::json entry = nlohmann::json::object ();
+
+	if (property->is<PropertySlider> ()) {
+	    entry["type"] = "slider";
+	    entry["value"] = property->getFloat ();
+	} else if (property->is<PropertyBoolean> ()) {
+	    entry["type"] = "bool";
+	    entry["value"] = property->getBool ();
+	} else if (property->is<PropertyColor> ()) {
+	    const glm::vec3& color = property->getVec3 ();
+	    std::ostringstream text;
+
+	    text << std::fixed << std::setprecision (5) << color.r << " " << color.g << " " << color.b;
+	    entry["type"] = "color";
+	    entry["value"] = text.str ();
+	} else if (property->is<PropertyCombo> ()) {
+	    entry["type"] = "combo";
+	    entry["value"] = property->toString ();
+	} else {
+	    entry["type"] = "text";
+	    entry["value"] = property->toString ();
+	}
+
+	values[name] = std::move (entry);
+    }
+
+    return "(function () {\n"
+	   "  var properties = "
+	+ values.dump ()
+	+ ";\n"
+	  "  var attempts = 0;\n"
+	  "  function deliver () {\n"
+	  "    var listener = window.wallpaperPropertyListener;\n"
+	  "    if (listener && typeof listener.applyUserProperties === 'function') {\n"
+	  "      try { listener.applyUserProperties (properties); } catch (e) { console.error (e); }\n"
+	  "      if (typeof listener.applyGeneralProperties === 'function') {\n"
+	  "        try { listener.applyGeneralProperties ({ fps: 30 }); } catch (e) { console.error (e); }\n"
+	  "      }\n"
+	  "    } else if (++attempts < 100) {\n"
+	  "      setTimeout (deliver, 100);\n"
+	  "    }\n"
+	  "  }\n"
+	  "  deliver ();\n"
+	  "})();\n";
+}
+} // namespace
